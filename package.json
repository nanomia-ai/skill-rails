{
  "name": "@nanomia/skill-rails",
  "version": "0.1.0",
  "private": true,
  "description": "Create, migrate, maintain, and verify drift-resistant AI-agent skills.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs --self",
    "eval": "node scripts/eval.mjs",
    "lint": "node scripts/lint.mjs --self",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm test && npm run eval"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "ajv": "^8.17.1"
  }
}
