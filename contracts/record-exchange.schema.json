{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/record-exchange/1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "exchangeId", "projectRoot", "targetRoot", "packageId", "packageVersion", "targetId", "receiptTreeSha256", "declaredOutput", "basis"],
      "properties": {
        "schemaVersion": {"const": 1},
        "mode": {"const": "record-only"},
        "exchangeId": {"type": "string", "minLength": 1},
        "projectRoot": {"type": "string", "minLength": 1},
        "targetRoot": {"type": "string", "minLength": 1},
        "packageId": {"type": "string", "minLength": 1},
        "packageVersion": {"type": "string", "minLength": 1},
        "targetId": {"type": "string", "minLength": 1},
        "receiptTreeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "declaredOutput": {"type": "string", "minLength": 1},
        "basis": {"$ref": "#/$defs/basisSet"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "exchangeId", "projectRoot", "targetRoot", "packageId", "packageVersion", "targetId", "receiptTreeSha256", "declaredOutput", "basis", "decisionSha256"],
      "properties": {
        "schemaVersion": {"const": 1},
        "mode": {"const": "prepare-record"},
        "exchangeId": {"type": "string", "minLength": 1},
        "projectRoot": {"type": "string", "minLength": 1},
        "targetRoot": {"type": "string", "minLength": 1},
        "packageId": {"type": "string", "minLength": 1},
        "packageVersion": {"type": "string", "minLength": 1},
        "targetId": {"type": "string", "minLength": 1},
        "receiptTreeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "declaredOutput": {"type": "string", "minLength": 1},
        "basis": {"$ref": "#/$defs/basisSet"},
        "decisionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  ],
  "$defs": {
    "basis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "state": {"const": "present"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "state": {"const": "absent"},
            "sha256": {"type": "null"}
          }
        }
      ]
    },
    "basisSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output"],
      "properties": {
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/basis"}},
        "output": {"$ref": "#/$defs/basis"}
      }
    }
  }
}
