{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/observed-facts/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "facts", "unknowns"],
  "properties": {
    "schemaVersion": {"const": 1},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "basisPaths", "authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {},
          "basisPaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "authority": {"const": "machine-observed"}
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasonCode", "basisPaths"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reasonCode": {"type": "string", "minLength": 1},
          "basisPaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
