{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/packet-kernel/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purposeModule", "action", "judgment", "reads", "doneWhen"],
  "properties": {
    "schemaVersion": {"const": 1},
    "purposeModule": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "action": {"type": "string", "minLength": 1},
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "criteria"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "doneWhen": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
