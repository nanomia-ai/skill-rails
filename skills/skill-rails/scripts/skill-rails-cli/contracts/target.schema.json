{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/target/1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "targetId", "mode", "entry", "imports"],
      "properties": {
        "schemaVersion": {"const": 1},
        "targetId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mode": {"const": "prose"},
        "entry": {"type": "string", "minLength": 1},
        "imports": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "uniqueItems": true},
        "headingIndex": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "embeddedCoreTooling": {"const": "authoring-cli-v1"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "targetId", "mode", "entry", "imports", "fallbackModule", "domainConfig", "domainConfigSchema", "packet", "observer", "renderer", "answerContract", "declaredInputs", "declaredOutput", "outputMode", "regionBootstrap"],
      "properties": {
        "schemaVersion": {"const": 1},
        "targetId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mode": {"const": "prepare-record"},
        "entry": {"type": "string", "minLength": 1},
        "imports": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "uniqueItems": true},
        "fallbackModule": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "domainConfig": {"type": "string", "minLength": 1},
        "domainConfigSchema": {"type": "string", "minLength": 1},
        "packet": {"type": "string", "minLength": 1},
        "observer": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "answerContract": {"type": "string", "minLength": 1},
        "declaredInputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "declaredOutput": {"type": "string", "minLength": 1},
        "outputMode": {"const": "managed-region"},
        "regionBootstrap": {"const": "append-managed-region"},
        "headingIndex": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "targetId", "mode", "entry", "imports", "domainConfig", "domainConfigSchema", "renderer", "answerContract", "declaredInputs", "declaredOutput", "outputMode", "regionBootstrap"],
      "properties": {
        "schemaVersion": {"const": 1},
        "targetId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mode": {"const": "record-only"},
        "entry": {"type": "string", "minLength": 1},
        "imports": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "uniqueItems": true},
        "domainConfig": {"type": "string", "minLength": 1},
        "domainConfigSchema": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "answerContract": {"type": "string", "minLength": 1},
        "declaredInputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "declaredOutput": {"type": "string", "minLength": 1},
        "outputMode": {"const": "managed-region"},
        "regionBootstrap": {"const": "append-managed-region"},
        "headingIndex": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
      }
    }
  ]
}
