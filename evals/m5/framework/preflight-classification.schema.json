{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/framework-preflight-classification/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classificationId", "protocolId", "replacementProtocolId", "entries", "claimPolicy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "classificationId": {"const": "m5-framework-v1-preflight-classification"},
    "protocolId": {"const": "m5-framework-lanes-v1"},
    "replacementProtocolId": {"const": "m5-framework-lanes-v2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cellId", "classification", "reason", "receiptPath", "stdoutPath", "stderrPath"],
        "properties": {
          "cellId": {"type": "string", "minLength": 1},
          "classification": {"enum": ["harness-defect", "superseded-by-protocol-v2"]},
          "reason": {"type": "string", "minLength": 1},
          "receiptPath": {"type": "string", "minLength": 1},
          "stdoutPath": {"type": "string", "minLength": 1},
          "stderrPath": {"type": "string", "minLength": 1}
        }
      }
    },
    "claimPolicy": {"type": "string", "minLength": 1}
  }
}
