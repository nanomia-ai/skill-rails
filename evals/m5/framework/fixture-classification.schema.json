{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-rails-next/framework-fixture-classification/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "entries", "claimPolicy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolId": {"const": "m5-framework-lanes-v2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cellId", "fixtureRevision", "classification", "reason", "receiptPath", "stdoutPath", "stderrPath", "replacementFixtureRevision"],
        "properties": {
          "cellId": {"type": "string", "minLength": 1},
          "fixtureRevision": {"type": "integer", "minimum": 1},
          "classification": {"const": "superseded-by-fixture-revision"},
          "reason": {"type": "string", "minLength": 1},
          "receiptPath": {"type": "string", "minLength": 1},
          "stdoutPath": {"type": "string", "minLength": 1},
          "stderrPath": {"type": "string", "minLength": 1},
          "replacementFixtureRevision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "claimPolicy": {"type": "string", "minLength": 1}
  }
}
