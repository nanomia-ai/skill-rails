{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "natural-language-pilot/semantic-answer.verify/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cardId", "verdict", "summary", "checks", "unknowns"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cardId": {"const": "bookmark-storage"},
    "verdict": {"enum": ["pass", "fail", "unproven"]},
    "summary": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "outcome", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "outcome": {"const": "pass"},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "outcome", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "outcome": {"enum": ["fail", "unproven"]},
              "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
            }
          }
        ]
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "reference"],
      "properties": {
        "authority": {"const": "ai-reported"},
        "reference": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
      }
    }
  }
}
